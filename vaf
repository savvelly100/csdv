local TS = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local Players = game:GetService("Players")

local function C(cls, props)
    local o = Instance.new(cls)
    for k, v in next, props do o[k] = v end
    return o
end

local function tw(obj, props, dur, style, dir)
    local t = TS:Create(obj, TweenInfo.new(dur or 0.16, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
    t:Play()
    return t
end

local function corner(o, r)
    return C("UICorner", { CornerRadius = UDim.new(0, r or 6), Parent = o })
end

local function stroke(o, a, t)
    return C("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = a or 0.93, Thickness = t or 1, Parent = o })
end

local function pad(o, t, r, b, l)
    return C("UIPadding", {
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
        PaddingLeft = UDim.new(0, l or 0),
        Parent = o,
    })
end

local function drag(frame, handle)
    handle = handle or frame
    local active, startPos, startInput
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            active, startPos, startInput = true, frame.Position, input.Position
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if active and input.UserInputType == Enum.UserInputType.MouseMovement then
            local d = input.Position - startInput
            frame.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then active = false end
    end)
end

local function root()
    local ok, h = pcall(gethui)
    if ok and h then return h end
    local ok2, cg = pcall(function() return game:GetService("CoreGui") end)
    if ok2 and cg then return cg end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local P = {
    bg       = Color3.fromRGB(11, 11, 13),
    surface  = Color3.fromRGB(18, 18, 21),
    elevated = Color3.fromRGB(23, 23, 27),
    hover    = Color3.fromRGB(29, 29, 34),
    field    = Color3.fromRGB(13, 13, 16),
    text     = Color3.fromRGB(232, 232, 237),
    muted    = Color3.fromRGB(105, 105, 115),
    dim      = Color3.fromRGB(148, 148, 158),
    track    = Color3.fromRGB(38, 38, 46),
}

local SCREEN = C("ScreenGui", {
    Name = "MinimalUI",
    ResetOnSpawn = false,
    ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
    DisplayOrder = 999,
    Parent = root(),
})

local Lib = {}

function Lib:Window(opts)
    opts = opts or {}
    local accent = opts.Accent or Color3.fromRGB(230, 200, 152)
    local toggleKey = opts.ToggleKey or Enum.KeyCode.RightShift
    local W, H = 560, 420
    local SIDEBAR, GAP, PADDING = 140, 14, 16

    local frame = C("Frame", {
        Name = "Window",
        Size = UDim2.new(0, W, 0, H),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        BackgroundColor3 = P.bg,
        BorderSizePixel = 0,
        Parent = SCREEN,
    })
    corner(frame, 8)
    stroke(frame, 0.90)
    local uscale = C("UIScale", { Scale = 0.94, Parent = frame })
    tw(uscale, { Scale = 1 }, 0.3, Enum.EasingStyle.Quart)

    local top = C("Frame", {
        Size = UDim2.new(1, 0, 0, 48),
        BackgroundTransparency = 1,
        Parent = frame,
    })

    C("TextLabel", {
        Size = UDim2.new(1, -160, 1, 0),
        Position = UDim2.new(0, PADDING + 2, 0, 0),
        BackgroundTransparency = 1,
        Text = opts.Title or "Menu",
        TextColor3 = P.text,
        Font = Enum.Font.GothamMedium,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = top,
    })

    local ctrl = C("Frame", {
        Size = UDim2.new(0, 76, 0, 26),
        Position = UDim2.new(1, -PADDING - 76, 0.5, -13),
        BackgroundTransparency = 1,
        Parent = top,
    })
    C("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 4),
        Parent = ctrl,
    })

    local minimized, closed = false, false
    local body
    local activePopup = nil
    local activeKeybind = nil

    local function closePopup()
        if not activePopup then return end
        local p = activePopup
        activePopup = nil
        local h = p.Size
        tw(p, { Size = UDim2.new(h.X.Scale, h.X.Offset, 0, 0) }, 0.14)
        task.delay(0.16, function() p:Destroy() end)
    end

    local function ctrlBtn(glyph, cb)
        local b = C("TextButton", {
            Size = UDim2.new(0, 26, 0, 26),
            BackgroundColor3 = P.surface,
            BackgroundTransparency = 1,
            Text = glyph,
            TextColor3 = P.muted,
            Font = Enum.Font.GothamMedium,
            TextSize = 15,
            AutoButtonColor = false,
            Parent = ctrl,
        })
        corner(b, 4)
        b.MouseEnter:Connect(function() tw(b, { BackgroundTransparency = 0, TextColor3 = P.text }, 0.14) end)
        b.MouseLeave:Connect(function() tw(b, { BackgroundTransparency = 1, TextColor3 = P.muted }, 0.14) end)
        b.MouseButton1Click:Connect(cb)
        return b
    end

    ctrlBtn("−", function()
        minimized = not minimized
        if minimized then
            body.Visible = false
            tw(frame, { Size = UDim2.new(0, W, 0, 48) }, 0.22, Enum.EasingStyle.Quart)
        else
            body.Visible = true
            tw(frame, { Size = UDim2.new(0, W, 0, H) }, 0.22, Enum.EasingStyle.Quart)
        end
    end)

    ctrlBtn("×", function()
        closePopup()
        closed = true
        frame.Visible = false
    end)

    UIS.InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            if closed then
                closed = false
                frame.Visible = true
                uscale.Scale = 0.94
                tw(uscale, { Scale = 1 }, 0.22, Enum.EasingStyle.Quart)
            else
                closePopup()
                closed = true
                frame.Visible = false
            end
        elseif input.KeyCode == Enum.KeyCode.Escape then
            closePopup()
        end
    end)

    body = C("Frame", {
        Size = UDim2.new(1, 0, 1, -48),
        Position = UDim2.new(0, 0, 0, 48),
        BackgroundTransparency = 1,
        Parent = frame,
    })
    pad(body, 0, PADDING, PADDING, PADDING)

    local side = C("Frame", {
        Size = UDim2.new(0, SIDEBAR, 1, 0),
        BackgroundColor3 = P.surface,
        BorderSizePixel = 0,
        Parent = body,
    })
    corner(side, 6)
    stroke(side, 0.93)
    pad(side, 8, 8, 8, 8)

    local tabList = C("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = side,
    })
    C("UIListLayout", {
        Padding = UDim.new(0, 2),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = tabList,
    })

    local content = C("ScrollingFrame", {
        Size = UDim2.new(1, -(SIDEBAR + GAP), 1, 0),
        Position = UDim2.new(0, SIDEBAR + GAP, 0, 0),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 2,
        ScrollBarImageColor3 = P.track,
        ScrollBarImageTransparency = 0.3,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollingDirection = Enum.ScrollingDirection.Y,
        Parent = body,
    })
    C("UIListLayout", {
        Padding = UDim.new(0, 14),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = content,
    })

    drag(frame, top)

    local tabs = {}
    local activeTab = nil
    local TAB_H, TAB_GAP = 30, 2

    local ind = C("Frame", {
        Size = UDim2.new(0, 2, 0, 18),
        BackgroundColor3 = accent,
        BorderSizePixel = 0,
        Visible = false,
        ZIndex = 5,
        Parent = side,
    })
    corner(ind, 1)

    local function selectTab(tab)
        if activeTab == tab then return end
        if activeTab then
            tw(activeTab.Button, { BackgroundTransparency = 1 }, 0.15)
            tw(activeTab.Label, { TextColor3 = P.muted }, 0.15)
            activeTab.Page.Visible = false
        end
        activeTab = tab
        tab.Page.Visible = true
        tw(tab.Button, { BackgroundTransparency = 0.90 }, 0.15)
        tw(tab.Label, { TextColor3 = P.text }, 0.15)
        local relY = tab.Button.AbsolutePosition.Y - side.AbsolutePosition.Y
        ind.Visible = true
        tw(ind, { Position = UDim2.new(0, 0, 0, relY + (TAB_H - 18) / 2) }, 0.2)
    end

    local Win = {}

    function Win:Tab(name, order)
        local tab = { Sections = 0 }
        local idx = #tabs + 1

        local btn = C("TextButton", {
            Size = UDim2.new(1, 0, 0, TAB_H),
            BackgroundColor3 = accent,
            BackgroundTransparency = 1,
            Text = "",
            AutoButtonColor = false,
            LayoutOrder = order or idx,
            Parent = tabList,
        })
        corner(btn, 4)

        local lbl = C("TextLabel", {
            Size = UDim2.new(1, -20, 1, 0),
            Position = UDim2.new(0, 12, 0, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = P.muted,
            Font = Enum.Font.Gotham,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = btn,
        })

        local page = C("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            Visible = false,
            LayoutOrder = order or idx,
            Parent = content,
        })
        C("UIListLayout", {
            Padding = UDim.new(0, 14),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = page,
        })

        tab.Button, tab.Label, tab.Page = btn, lbl, page

        btn.MouseButton1Click:Connect(function() selectTab(tab) end)
        btn.MouseEnter:Connect(function()
            if activeTab ~= tab then tw(btn, { BackgroundTransparency = 0.95 }, 0.14) end
        end)
        btn.MouseLeave:Connect(function()
            if activeTab ~= tab then tw(btn, { BackgroundTransparency = 1 }, 0.14) end
        end)

        table.insert(tabs, tab)
        task.defer(function()
            if not activeTab then selectTab(tab) end
        end)

        function tab:Section(title, order)
            tab.Sections = tab.Sections + 1
            local section = {}

            local holder = C("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                LayoutOrder = order or tab.Sections,
                Parent = page,
            })
            C("UIListLayout", {
                Padding = UDim.new(0, 8),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = holder,
            })

            if title and title ~= "" then
                C("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Text = string.upper(title),
                    TextColor3 = P.muted,
                    Font = Enum.Font.GothamBold,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    LayoutOrder = 0,
                    Parent = holder,
                })
            end

            local card = C("Frame", {
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundColor3 = P.elevated,
                BorderSizePixel = 0,
                LayoutOrder = 1,
                Parent = holder,
            })
            corner(card, 6)
            stroke(card, 0.93)
            C("UIListLayout", {
                Padding = UDim.new(0, 0),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = card,
            })

            local counter = 0
            local function add(el, noDivider)
                if not noDivider and counter > 0 then
                    counter = counter + 1
                    C("Frame", {
                        Size = UDim2.new(1, 0, 0, 1),
                        BackgroundColor3 = Color3.new(1, 1, 1),
                        BackgroundTransparency = 0.94,
                        BorderSizePixel = 0,
                        LayoutOrder = counter,
                        Parent = card,
                    })
                end
                counter = counter + 1
                el.LayoutOrder = counter
                el.Parent = card
                return el
            end

            function section:Toggle(name, default, cb)
                local state = default == nil and false or default
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                })
                pad(row, 0, 14, 0, 14)

                C("TextLabel", {
                    Size = UDim2.new(1, -50, 1, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = P.text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })

                local sw = C("Frame", {
                    Size = UDim2.new(0, 32, 0, 16),
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    BackgroundColor3 = state and accent or P.track,
                    BorderSizePixel = 0,
                    Parent = row,
                })
                corner(sw, 8)

                local knob = C("Frame", {
                    Size = UDim2.new(0, 12, 0, 12),
                    AnchorPoint = Vector2.new(0, 0.5),
                    Position = state and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    Parent = sw,
                })
                corner(knob, 6)

                local hit = C("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = row,
                })
                hit.MouseButton1Click:Connect(function()
                    state = not state
                    tw(sw, { BackgroundColor3 = state and accent or P.track }, 0.15)
                    tw(knob, {
                        Position = state and UDim2.new(1, -14, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
                    }, 0.15)
                    if cb then cb(state) end
                end)
                hit.MouseEnter:Connect(function() tw(row, { BackgroundTransparency = 0.94 }, 0.14) end)
                hit.MouseLeave:Connect(function() tw(row, { BackgroundTransparency = 1 }, 0.14) end)
                return add(row)
            end

            function section:Slider(name, min, max, default, cb)
                local state = default == nil and min or default
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 54),
                    BackgroundTransparency = 1,
                })
                pad(row, 0, 14, 0, 14)

                C("TextLabel", {
                    Size = UDim2.new(1, -60, 0, 20),
                    Position = UDim2.new(0, 0, 0, 10),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = P.text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })

                local vLbl = C("TextLabel", {
                    Size = UDim2.new(0, 60, 0, 20),
                    Position = UDim2.new(1, -60, 0, 10),
                    BackgroundTransparency = 1,
                    Text = tostring(state),
                    TextColor3 = P.dim,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = row,
                })

                local track = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 2),
                    Position = UDim2.new(0, 0, 0, 40),
                    BackgroundColor3 = P.track,
                    BorderSizePixel = 0,
                    Parent = row,
                })
                corner(track, 1)

                local norm = (state - min) / (max - min)
                local fill = C("Frame", {
                    Size = UDim2.new(norm, 0, 1, 0),
                    BackgroundColor3 = accent,
                    BorderSizePixel = 0,
                    Parent = track,
                })
                corner(fill, 1)

                local knob = C("Frame", {
                    Size = UDim2.new(0, 10, 0, 10),
                    AnchorPoint = Vector2.new(0.5, 0.5),
                    Position = UDim2.new(norm, 0, 0.5, 0),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BorderSizePixel = 0,
                    ZIndex = 2,
                    Parent = track,
                })
                corner(knob, 5)

                local hit = C("TextButton", {
                    Size = UDim2.new(1, 0, 0, 22),
                    Position = UDim2.new(0, 0, 0, 29),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = row,
                })

                local dragging = false
                local function update(mx)
                    local x0 = track.AbsolutePosition.X
                    local tw_ = track.AbsoluteSize.X
                    local n = math.clamp((mx - x0) / tw_, 0, 1)
                    local v = min + (max - min) * n
                    v = math.floor(v * 100 + 0.5) / 100
                    state = v
                    vLbl.Text = tostring(v)
                    fill.Size = UDim2.new(n, 0, 1, 0)
                    knob.Position = UDim2.new(n, 0, 0.5, 0)
                    if cb then cb(v) end
                end

                hit.MouseButton1Down:Connect(function(x)
                    dragging = true
                    update(x)
                end)
                UIS.InputChanged:Connect(function(input)
                    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                        update(input.Position.X)
                    end
                end)
                UIS.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
                end)
                return add(row)
            end

            function section:Button(name, cb)
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                })
                pad(row, 0, 14, 0, 14)

                C("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = P.text,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Center,
                    Parent = row,
                })

                local hit = C("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = row,
                })
                hit.MouseButton1Click:Connect(function() if cb then cb() end end)
                hit.MouseEnter:Connect(function() tw(row, { BackgroundTransparency = 0.94 }, 0.14) end)
                hit.MouseLeave:Connect(function() tw(row, { BackgroundTransparency = 1 }, 0.14) end)
                return add(row)
            end

            function section:Dropdown(name, options, default, cb)
                local current = default or options[1]
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                    ClipsDescendants = false,
                })
                pad(row, 0, 14, 0, 14)

                C("TextLabel", {
                    Size = UDim2.new(1, -110, 1, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = P.text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })

                local valLbl = C("TextLabel", {
                    Size = UDim2.new(0, 90, 1, 0),
                    Position = UDim2.new(1, -100, 0, 0),
                    BackgroundTransparency = 1,
                    Text = tostring(current) .. "  ▾",
                    TextColor3 = P.dim,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = row,
                })

                local hit = C("TextButton", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = "",
                    Parent = row,
                })

                local isOpen = false
                hit.MouseButton1Click:Connect(function()
                    if isOpen then
                        closePopup()
                        isOpen = false
                        return
                    end
                    closePopup()
                    isOpen = true

                    local popup = C("Frame", {
                        Position = UDim2.new(0, row.AbsolutePosition.X, 0, row.AbsolutePosition.Y + row.AbsoluteSize.Y + 4),
                        Size = UDim2.new(0, row.AbsoluteSize.X, 0, 0),
                        BackgroundColor3 = P.surface,
                        BorderSizePixel = 0,
                        ClipsDescendants = true,
                        ZIndex = 100,
                        Parent = SCREEN,
                    })
                    corner(popup, 6)
                    stroke(popup, 0.90)
                    C("UIListLayout", {
                        Padding = UDim.new(0, 0),
                        SortOrder = Enum.SortOrder.LayoutOrder,
                        Parent = popup,
                    })
                    pad(popup, 4, 4, 4, 4)

                    for i, opt in ipairs(options) do
                        local ob = C("TextButton", {
                            Size = UDim2.new(1, 0, 0, 28),
                            BackgroundColor3 = accent,
                            BackgroundTransparency = 1,
                            Text = tostring(opt),
                            TextColor3 = P.text,
                            Font = Enum.Font.Gotham,
                            TextSize = 13,
                            TextXAlignment = Enum.TextXAlignment.Left,
                            AutoButtonColor = false,
                            LayoutOrder = i,
                            Parent = popup,
                        })
                        corner(ob, 4)
                        pad(ob, 0, 10, 0, 10)
                        ob.MouseEnter:Connect(function()
                            tw(ob, { BackgroundTransparency = 0.88 }, 0.12)
                        end)
                        ob.MouseLeave:Connect(function()
                            tw(ob, { BackgroundTransparency = 1 }, 0.12)
                        end)
                        ob.MouseButton1Click:Connect(function()
                            current = opt
                            valLbl.Text = tostring(opt) .. "  ▾"
                            closePopup()
                            isOpen = false
                            if cb then cb(opt) end
                        end)
                    end

                    activePopup = popup
                    local target = #options * 28 + 8
                    tw(popup, { Size = UDim2.new(0, row.AbsoluteSize.X, 0, target) }, 0.16)
                end)

                hit.MouseEnter:Connect(function() tw(row, { BackgroundTransparency = 0.94 }, 0.14) end)
                hit.MouseLeave:Connect(function() tw(row, { BackgroundTransparency = 1 }, 0.14) end)
                return add(row)
            end

            function section:Input(name, default, cb)
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 66),
                    BackgroundTransparency = 1,
                })
                pad(row, 12, 14, 12, 14)

                C("TextLabel", {
                    Size = UDim2.new(1, 0, 0, 16),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = P.text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })

                local box = C("TextBox", {
                    Size = UDim2.new(1, 0, 0, 26),
                    Position = UDim2.new(0, 0, 0, 22),
                    BackgroundColor3 = P.field,
                    BorderSizePixel = 0,
                    Text = default or "",
                    PlaceholderText = "Type...",
                    TextColor3 = P.text,
                    PlaceholderColor3 = P.muted,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClearTextOnFocus = false,
                    Parent = row,
                })
                corner(box, 4)
                pad(box, 0, 8, 0, 8)
                stroke(box, 0.92)
                box.Focused:Connect(function()
                    tw(box, { BackgroundColor3 = Color3.fromRGB(17, 17, 21) }, 0.14)
                end)
                box.FocusLost:Connect(function()
                    tw(box, { BackgroundColor3 = P.field }, 0.14)
                    if cb then cb(box.Text) end
                end)
                return add(row)
            end

            function section:Keybind(name, default, cb)
                local current = default or Enum.KeyCode.Unknown
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 40),
                    BackgroundTransparency = 1,
                })
                pad(row, 0, 14, 0, 14)

                C("TextLabel", {
                    Size = UDim2.new(1, -100, 1, 0),
                    BackgroundTransparency = 1,
                    Text = name,
                    TextColor3 = P.text,
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })

                local kb = C("TextButton", {
                    Size = UDim2.new(0, 76, 0, 24),
                    AnchorPoint = Vector2.new(1, 0.5),
                    Position = UDim2.new(1, 0, 0.5, 0),
                    BackgroundColor3 = P.field,
                    BorderSizePixel = 0,
                    Text = current.Name,
                    TextColor3 = P.dim,
                    Font = Enum.Font.GothamMedium,
                    TextSize = 12,
                    AutoButtonColor = false,
                    Parent = row,
                })
                corner(kb, 4)
                stroke(kb, 0.92)

                kb.MouseEnter:Connect(function() tw(kb, { BackgroundColor3 = P.hover }, 0.14) end)
                kb.MouseLeave:Connect(function()
                    if activeKeybind ~= kb then tw(kb, { BackgroundColor3 = P.field }, 0.14) end
                end)
                kb.MouseButton1Click:Connect(function()
                    if activeKeybind and activeKeybind ~= kb then
                        activeKeybind.Text = activeKeybind:GetAttribute("prev") or "None"
                    end
                    activeKeybind = kb
                    kb:SetAttribute("prev", current.Name)
                    kb.Text = "..."
                    tw(kb, { BackgroundColor3 = P.hover }, 0.14)
                end)

                UIS.InputBegan:Connect(function(input)
                    if activeKeybind ~= kb then return end
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    if input.KeyCode == Enum.KeyCode.Escape then
                        kb.Text = kb:GetAttribute("prev") or "None"
                        activeKeybind = nil
                        tw(kb, { BackgroundColor3 = P.field }, 0.14)
                        return
                    end
                    current = input.KeyCode
                    kb.Text = current.Name
                    activeKeybind = nil
                    tw(kb, { BackgroundColor3 = P.field }, 0.14)
                    if cb then cb(current) end
                end)
                return add(row)
            end

            function section:Label(text)
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 32),
                    BackgroundTransparency = 1,
                })
                pad(row, 0, 14, 0, 14)
                C("TextLabel", {
                    Size = UDim2.new(1, 0, 1, 0),
                    BackgroundTransparency = 1,
                    Text = text,
                    TextColor3 = P.muted,
                    Font = Enum.Font.Gotham,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = row,
                })
                return add(row)
            end

            function section:Divider()
                local row = C("Frame", {
                    Size = UDim2.new(1, 0, 0, 1),
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    BackgroundTransparency = 0.90,
                    BorderSizePixel = 0,
                })
                return add(row, true)
            end

            return section
        end

        return tab
    end

    function Win:SetTitle(t)
        for _, d in next, top:GetChildren() do
            if d:IsA("TextLabel") then d.Text = t; break end
        end
    end

    function Win:Destroy()
        closePopup()
        frame:Destroy()
    end

    return Win
end

return Lib
